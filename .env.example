# --- Plan Player Analytics (SSR статистика на головній; без цього — дефолт dragonseven.top:25551) ---
# Графік онлайну та «зараз онлайн» на головній беруться з Plan, якщо доступні /v1/graph та /v1/serverOverview.
# LC_PLAN_BASE_URL=http://dragonseven.top:25551
# LC_PLAN_SERVER_NAME=Lost Chronicles Vanila
# Додаткові Plan-сервери (через кому), з чиїх «Online»-сесій збирати ніки; якщо не задано — також "Proxy Server".
# Щоб брати лише LC_PLAN_SERVER_NAME: LC_PLAN_EXTRA_SESSION_SERVERS=0
# LC_PLAN_EXTRA_SESSION_SERVERS=Proxy Server, Lobby

# --- Site (OAuth redirect & proposal links) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- SEO (опційно): код верифікації з Google Search Console → мета-тег google-site-verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Google Analytics 4: ідентифікатор потоку даних (Адміністратор → Потоки даних → Веб → Ідентифікатор потоку)
# Формат: G-XXXXXXXXXX. Після деплою перевірте у звітах «У реальному часі».
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- YouTube: останнє відео на головній (RSS; без API). Інакше — канал за замовчуванням у lc-youtube-promo.ts ---
# LC_YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# --- Публічні соцмережі (опційно; інакше значення з src/data/lc-social-defaults.ts) ---
# NEXT_PUBLIC_YOUTUBE_URL=
# NEXT_PUBLIC_DISCORD_URL=
# NEXT_PUBLIC_TIKTOK_URL=
# NEXT_PUBLIC_TELEGRAM_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=

# --- Session signing (min 16 characters) ---
AUTH_SECRET=replace-with-long-random-secret

# --- Neon Postgres (console.neon.tech) ---
# У Vercel: підключи інтеграцію Neon або встав скопійований connection string з Neon Dashboard.
# Формат: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=

# --- Discord OAuth2 (https://discord.com/developers/applications) ---
# У Discord → OAuth2 → Redirects додай URL для КОЖНОГО домену, з якого заходять
# (наприклад і vercel.app, і свій домен): https://домен/api/auth/discord/callback
# Логін тепер використовує хост з браузера, тому redirect має збігатися з тим, що в адресному рядку.
DISCORD_CLIENT_ID=
# Опційно замість DISCORD_CLIENT_ID (той самий Application ID, зручно на Vercel):
# NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Сповіщення про пропозиції (Discord webhook + Telegram — той самий події) ---
# Розпочато голосування при створенні; результати — коли термін вийшов або автор закрив достроково.
# Telegram: створи бота через @BotFather, додай у канал/групу, chat_id — @userinfobot або getUpdates
# Telegram: обовʼязково TELEGRAM_MESSAGE_THREAD_ID (id теми) — без нього бот нічого не надсилає
# Старт голосування й результати обидва йдуть у цю гілку, не в загальний чат
# Як дізнатись topic id: надішли повідомлення в потрібну гілку → getUpdates у бота або @RawDataBot
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

# --- Optional: Vercel Cron → POST /api/cron/close-proposals ---
# Header: Authorization: Bearer {CRON_SECRET}
CRON_SECRET=
